{
  "version": 1,
  "author": "Tinka Fahad",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-analog-signal-source",
      "id": "acs",
      "top": -120,
      "left": -180,
      "attrs": {
        "waveform": "sine",
        "frequency": "50",
        "amplitude": "0.5",
        "offset": "2.5"
      }
    },
    {
      "type": "wokwi-ssd1306",
      "id": "oled",
      "top": -120,
      "left": 200,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buz",
      "top": 80,
      "left": 200,
      "attrs": { "volume": "0.1" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 80,
      "left": -180,
      "attrs": { "color": "white" }
    },
    {
      "type": "wokwi-led",
      "id": "led_r",
      "top": -40,
      "left": 200,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-led",
      "id": "led_g",
      "top": -40,
      "left": 260,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-led",
      "id": "led_b",
      "top": -40,
      "left": 320,
      "attrs": { "color": "blue" }
    },
    { "type": "wokwi-resistor", "id": "r1", "top": -10, "left": 200, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": -10, "left": 260, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": -10, "left": 320, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:GPIO34", "acs:OUT", "yellow", [] ],
    [ "esp:GND.1",  "acs:GND", "black",  [] ],

    [ "esp:GPIO21", "oled:SDA", "green", [] ],
    [ "esp:GPIO22", "oled:SCL", "blue",  [] ],
    [ "esp:3V3",    "oled:VCC", "red",   [] ],
    [ "esp:GND.2",  "oled:GND", "black", [] ],

    [ "esp:GPIO25", "buz:1",    "purple", [] ],
    [ "esp:GND.3",  "buz:2",    "black",  [] ],

    [ "esp:GPIO32", "btn:1.l",  "white",  [] ],
    [ "esp:GND.1",  "btn:2.l",  "black",  [] ],

    [ "esp:GPIO26", "r1:1",     "red",    [] ],
    [ "r1:2",       "led_r:A",  "red",    [] ],
    [ "led_r:C",    "esp:GND.1","black",  [] ],

    [ "esp:GPIO27", "r2:1",     "green",  [] ],
    [ "r2:2",       "led_g:A",  "green",  [] ],
    [ "led_g:C",    "esp:GND.1","black",  [] ],

    [ "esp:GPIO14", "r3:1",     "blue",   [] ],
    [ "r3:2",       "led_b:A",  "blue",   [] ],
    [ "led_b:C",    "esp:GND.1","black",  [] ]
  ],
  "dependencies": {}
}
