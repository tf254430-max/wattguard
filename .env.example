# Copy this file to server/.env if you want to override defaults.

# HTTP server port for the dashboard and REST API
PORT=3000

# Public MQTT broker used by both firmware and backend
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883

# Topic prefix. Both the firmware and the backend MUST use the same value.
# Generate something unique for your build, e.g. tinka-wattguard-9f3a2
MQTT_TOPIC_PREFIX=tinka-wattguard-9f3a2

# Single device id used by the simulated meter
DEVICE_ID=WG-001

# Mains voltage assumed by the energy calculation (Uganda is 240 V single-phase)
MAINS_VOLTAGE=240

# Yaka alert thresholds (units remaining)
ALERT_CAUTION_UNITS=10
ALERT_WARNING_UNITS=5
ALERT_CRITICAL_UNITS=1

# Telemetry retention in days; older rows pruned at startup
RETENTION_DAYS=90
